# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Internal research/planning notes — kept local only, not part of the
# shipped repo. The public legal pages that are generated FROM some of these
# files (Privacy Policy, Terms, deletion instructions) are still published
# as tracked HTML under /docs — see tool/build_legal_pages.py.
/Documents/

# Local-only throwaway scripts for manually poking at the code
/dev_scratch/

# Secrets - never commit (see Documents/FOUNDER_LAUNCH_GUIDE.md)
.env
.env.*
google-services.json
android/key.properties
*.jks
*.keystore
